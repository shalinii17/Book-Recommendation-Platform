<%- include("partials/header.ejs") %>

<div class="page-container">

    <!-- Hero -->
    <div class="hero-section">
        <h1 class="hero-title">Discover Your Next <span class="accent">Great Read</span></h1>
        <p class="hero-subtitle">Browse thousands of books, save your favourites, and build your reading list.</p>
    </div>

    <!-- Search Bar -->
    <form action="/" method="GET" class="search-bar">
        <input type="text" name="query" class="search-input" placeholder="Search by title or author..." value="<%= query || '' %>">
        <input type="text" name="genre" class="search-input" placeholder="Genre..." value="<%= genre || '' %>">
        <input type="hidden" name="page" value="1">
        <button class="search-btn" type="submit">Search</button>
        <a href="/" class="clear-btn">Clear</a>
    </form>

    <!-- Books Grid -->
    <% if (books && books.length > 0) { %>
        <div class="books-grid">
            <% books.forEach(book => { %>
                <div class="book-card">
                    <div class="book-cover-wrap">
                        <% if (book.cover_url) { %>
                            <img src="<%= book.cover_url %>" alt="<%= book.title %>" class="book-cover-img">
                        <% } else { %>
                            <div class="book-cover-placeholder">No Cover</div>
                        <% } %>
                    </div>
                    <div class="book-info">
                        <h3 class="book-title" title="<%= book.title %>"><%= book.title %></h3>
                        <p class="book-author"><%= book.author %></p>
                        <% if (book.genre) { %>
                            <span class="book-genre"><%= book.genre.split(',')[0].trim() %></span>
                        <% } %>
                        <% if (book.description) { %>
                            <p class="book-desc"><%= book.description.length > 80 ? book.description.slice(0, 80) + '...' : book.description %></p>
                        <% } %>
                        <% if (user) { %>
                            <div class="book-actions">
                                <form action="/mark" method="POST" style="display:inline">
                                    <input type="hidden" name="book_id" value="<%= book.id %>">
                                    <input type="hidden" name="action" value="already read">
                                    <input type="hidden" name="redirect" value="/">
                                    <button class="action-btn btn-read">Read</button>
                                </form>
                                <form action="/mark" method="POST" style="display:inline">
                                    <input type="hidden" name="book_id" value="<%= book.id %>">
                                    <input type="hidden" name="action" value="recommend">
                                    <input type="hidden" name="redirect" value="/">
                                    <button class="action-btn btn-recommend">Recommend</button>
                                </form>
                                <form action="/mark" method="POST" style="display:inline">
                                    <input type="hidden" name="book_id" value="<%= book.id %>">
                                    <input type="hidden" name="action" value="save">
                                    <input type="hidden" name="redirect" value="/">
                                    <button class="action-btn btn-save">Save</button>
                                </form>
                            </div>
                        <% } else { %>
                            <a href="/login" class="login-prompt">Login to save</a>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <p>No books found matching your criteria.</p>
            <a href="/" class="clear-btn">Clear filters</a>
        </div>
    <% } %>

    <!-- Pagination -->
    <div class="pagination-wrap">
        <a href="/?query=<%= query || '' %>&genre=<%= genre || '' %>&page=<%= currentPage - 1 %>"
           class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">&laquo; Prev</a>
        <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
        <a href="/?query=<%= query || '' %>&genre=<%= genre || '' %>&page=<%= currentPage + 1 %>"
           class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">Next &raquo;</a>
    </div>

</div>

<%- include("partials/footer.ejs") %>
