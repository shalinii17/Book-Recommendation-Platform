<%- include("partials/header.ejs") %>

<div class="page-container">

    <div class="profile-header">
        <div>
            <h2 class="profile-title">My Library</h2>
            <p class="profile-sub">Your personal reading collection</p>
        </div>
        <a href="/" class="nav-btn nav-btn-outline">Browse Books</a>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav">
        <a href="/profile?tab=already" class="tab-btn <%= tab==='already' ? 'tab-active' : '' %>">Already Read</a>
        <a href="/profile?tab=recommend" class="tab-btn <%= tab==='recommend' ? 'tab-active' : '' %>">Recommended</a>
        <a href="/profile?tab=save" class="tab-btn <%= tab==='save' ? 'tab-active' : '' %>">Saved</a>
    </div>

    <!-- Search Bar -->
    <form action="/profile" method="GET" class="search-bar" style="margin-bottom: 1.5rem;">
        <input type="hidden" name="tab" value="<%= tab %>">
        <input type="text" name="query" class="search-input" placeholder="Search your books..." value="<%= query || '' %>">
        <button class="search-btn" type="submit">Search</button>
        <a href="/profile?tab=<%= tab %>" class="clear-btn">Clear</a>
    </form>

    <!-- Search Result -->
    <% if (query) { %>
        <% if (!searchedBook) { %>
            <div class="alert-box alert-warn">No book found matching "<%= query %>".</div>
        <% } else { %>
            <div class="search-result-card">
                <div class="search-result-info">
                    <strong><%= searchedBook.title %></strong>
                    <span>by <%= searchedBook.author %></span>
                    <% if (searchedBook.genre) { %><span class="book-genre"><%= searchedBook.genre %></span><% } %>
                </div>
                <% if (user) { %>
                    <form action="/add" method="POST">
                        <input type="hidden" name="title" value="<%= searchedBook.title %>">
                        <input type="hidden" name="author" value="<%= searchedBook.author %>">
                        <input type="hidden" name="genre" value="<%= searchedBook.genre %>">
                        <input type="hidden" name="rating" value="<%= searchedBook.rating %>">
                        <input type="hidden" name="redirect" value="/profile?tab=<%= tab %>">
                        <button class="action-btn btn-read">Add to Library</button>
                    </form>
                <% } %>
            </div>
        <% } %>
    <% } %>

    <!-- Add Book Form -->
    <div class="add-book-section">
        <h4 class="add-book-title">Add a Book Manually</h4>
        <form action="/add" method="POST" class="add-book-form">
            <input type="hidden" name="redirect" value="/profile?tab=<%= tab %>">
            <input type="text" name="title" placeholder="Book Title" class="form-field" required>
            <input type="text" name="author" placeholder="Author" class="form-field" required>
            <input type="text" name="genre" placeholder="Genre" class="form-field">
            <input type="number" name="rating" placeholder="Rating (1-5)" class="form-field" step="0.1" min="1" max="5">
            <button class="search-btn" type="submit">Add Book</button>
        </form>
    </div>

    <!-- Books List -->
    <% if (books && books.length > 0) { %>
        <div class="profile-books-list">
            <% books.forEach(b => { %>
                <div class="profile-book-row">
                    <div class="profile-book-info">
                        <span class="profile-book-title"><%= b.title %></span>
                        <span class="profile-book-author">by <%= b.author %></span>
                        <% if (b.genre) { %><span class="book-genre"><%= b.genre.split(',')[0].trim() %></span><% } %>
                    </div>
                    <div class="profile-book-meta">
                        <% if (b.user_rating) { %>
                            <span class="rating-badge"><%= b.user_rating %> ★</span>
                        <% } %>
                        <form action="/unmark" method="POST" style="display:inline">
                            <input type="hidden" name="book_id" value="<%= b.id %>">
                            <input type="hidden" name="redirect" value="/profile?tab=<%= tab %>">
                            <button class="action-btn btn-remove">Remove</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <p>No books here yet. Start adding some!</p>
            <a href="/" class="search-btn" style="display:inline-block; margin-top: 0.5rem;">Browse Books</a>
        </div>
    <% } %>

</div>

<%- include("partials/footer.ejs") %>
